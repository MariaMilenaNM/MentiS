# Copie para .env e preencha. O .env não vai para o git.

# Modelo do agente no formato "provedor:modelo" (initChatModel do langchain.js).
# Deixe "fake" para rodar sem chave. Para um provedor real, instale o pacote dele,
# ex.: npm i @langchain/anthropic  e defina a chave correspondente abaixo.
LLM_MODEL=fake
LLM_TEMPERATURE=0.3

# Chave do provedor escolhido (só a que for usar)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
